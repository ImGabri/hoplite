{
  "schemaVersion": 1,
  "id": "slotcycler",
  "version": "${version}",
  "name": "Slot Cycler",
  "description": "Client-side utility: cycle an item between two hotbar slots, check for ghost items and drop surplus. X to run, Right Shift for settings.",
  "environment": "client",
  "authors": ["ImGabri"],
  "contact": {
    "homepage": "https://github.com/ImGabri/slotcycler",
    "issues": "https://github.com/ImGabri/slotcycler/issues",
    "sources": "https://github.com/ImGabri/slotcycler"
  },
  "entrypoints": {
    "main": ["slotcycler.SlotCyclerServer"],
    "client": ["slotcycler.SlotCyclerMod"]
  },
  "mixins": [],
  "depends": {
    "fabricloader": ">=0.18.2",
    "fabric-api": "*",
    "fabric-language-kotlin": "*",
    "minecraft": "~1.21.11",
    "java": ">=21"
  }
}
