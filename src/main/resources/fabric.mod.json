{
  "schemaVersion": 1,
  "id": "slotcycler",
  "version": "${version}",
  "name": "Slot Cycler",
  "description": "Client-side utility: cycle items, create real copies in singleplayer/creative mode, show display copies, check ghosts and drop surplus. No server installation needed.",
  "environment": "client",
  "authors": ["ImGabri"],
  "contact": {
    "homepage": "https://github.com/ImGabri/slotcycler",
    "issues": "https://github.com/ImGabri/slotcycler/issues",
    "sources": "https://github.com/ImGabri/slotcycler"
  },
  "entrypoints": {
    "client": ["slotcycler.SlotCyclerMod"]
  },
  "mixins": [],
  "depends": {
    "fabricloader": ">=0.18.2",
    "fabric-api": "*",
    "fabric-language-kotlin": "*",
    "minecraft": "~1.21.11",
    "java": ">=21"
  }
}
