{
  "schemaVersion": 1,
  "id": "slotcycler",
  "version": "${version}",
  "name": "Slot Cycler",
  "description": "Client-side quality of life: trade max, container buttons, a movable HUD for durability, items and effects, alerts, zoom, an FPS preset, and the Slot Cycler inventory tool. No server installation needed.",
  "environment": "client",
  "authors": [
    "ImGabri"
  ],
  "contact": {
    "homepage": "https://github.com/ImGabri/slotcycler",
    "issues": "https://github.com/ImGabri/slotcycler/issues",
    "sources": "https://github.com/ImGabri/slotcycler"
  },
  "entrypoints": {
    "client": [
      "slotcycler.SlotCyclerMod"
    ],
    "modmenu": [
      "slotcycler.ModMenuCompat"
    ]
  },
  "mixins": [],
  "depends": {
    "fabricloader": ">=0.18.2",
    "fabric-api": "*",
    "fabric-language-kotlin": "*",
    "minecraft": "~1.21.11",
    "java": ">=21"
  },
  "recommends": {
    "sodium": "*",
    "lithium": "*"
  },
  "icon": "assets/slotcycler/icon.png",
  "license": "MIT",
  "suggests": {
    "modmenu": "*"
  }
}
